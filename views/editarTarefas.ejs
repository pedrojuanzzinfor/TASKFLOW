<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <% if (nomeTabela=="tarefas"){%>
    <h1>concluir tarefa</h1>
    <form method="post" action="update">
        <h2>id tarefa</h2>
        <% if(Array.isArray(tabela)){ tabela.map((i)=>{%>
            <input type="radio" name="id" value="<%=i.id%>">
            <%=i.id%>-<%=i.titulo%>
            <input type="hidden" name="tabela" value="<%=nomeTabela%>">
                ,<%})}%>
        <button type="submit">ok</button>
    </form>
    <%}
    else{
        tabela.map((i)=>{
            %>
            <form method="post" action="update">
            <input type="text" value="<%=i.nome%>" name="nome">
            <input type="hidden" value="<%=nomeTabela%>" name="tabela">
            <input type="hidden" value="<%=i.id%>" name="id">
            <button type="submit">ok</button>
            </form>
        <% })}%>
</body>

</html>