<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>concluir tarefa</h1>
    <form method="post" action="updateTarefas">
        <h2>id tarefa</h2>
        <% if(Array.isArray(tarefas)){ tarefas.map((i)=>{%>
            <input type="radio" name="linha" value="<%=i.id%>">
            <%=i.id%>-<%=i.titulo%>
                ,<%})}%>
        <button type="submit">ok</button>
    </form>
</body>

</html>