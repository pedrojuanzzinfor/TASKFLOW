<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Cadastrar nova tarefa</h1>
    <form method="post" action="insertTarefa">
        <input type="text" name="titulo" placeholder="nome" required>
        <input type="text" name="descricao" placeholder="descricao" required>
        <select name="usuario">
            <%usuarios.map((i)=>{
                %>
                <option value="<%=i.id%>">
                    <%=i.nome%>
                </option>
                <% })%>
        </select>
        <select name="categoria">
            <%categorias.map((i)=>{
                %>
                <option value="<%=i.id%>">
                    <%=i.nome%>
                </option>
                <% })%>
        </select>
        <button type="submit">cadastrar nova tarefa</button>
    </form>

</body>

</html>