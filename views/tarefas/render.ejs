<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <form method="get" action="filtrar">
        <select name="status">
            <option value=""></option>
            <option value="concluido">concluido</option>
            <option value="pendente">pendente</option>

        </select>

        <select name="usuario_id">
            <option value=""></option>
            <%usuarios.map((i)=>{
                %>
                <option value="<%=i.id%>">
                    <%=i.nome%>
                </option>
                <% })%>
        </select>
        <select name="categoria_id">
            <option value=""></option>
            <%categorias.map((i)=>{
                %>
                <option value="<%=i.id%>">
                    <%=i.nome%>
                </option>
                <% })%>
        </select>
        <button type="submit">ok</button>
    </form>
        <% tarefas.map((i)=>{
            %>
            <p>
                <%=i.titulo%>-<%=i.descricao%>-<%=i.status%>-criado em:<%=i.criado_em%> Responsável:<%=i.nome%>
                                    Categoria:
                                    <%=i.nome_categoria%>
            </p>



            <% })%>
</body>

</html>