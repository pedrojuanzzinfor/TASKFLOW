<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>editar tarefa</h1>
    <form method="post" action="/tarefas/atualizar">
        <input type="hidden" name="id" value="<%= tarefa.id %>">
        <input type='text' name='titulo' value="<%=tarefa.titulo%>">
        <input type='text' name='descricao' value="<%=tarefa.descricao%>">
        <input type='radio' name='status' value="concluido" <% console.log(tarefa.status)
        if(tarefa.status=="concluido"){%> checked <%}%>>concluido
        <input type='radio' name='status' value="pendente" <%if(tarefa.status=="pendente"){%> checked <%}%>>pendente
        <select name="usuario">
        <% usuarios.map((i)=>{%>
            <option value="<%=usuario.id%>"><%=usuario.nome%></option>
        <%})%>
        <% categorias.map((i)=>{%>
            <option value="<%=categoria.id%>"><%=categoria.nome%></option>
        <%})%>
        </select>
        <button type="submit">ok</button>

    </form>

</body>

</html>